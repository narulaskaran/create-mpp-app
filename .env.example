# Copy this file to `.env` for local testing.
# Vercel will also use the same variable names in project settings.

# Privy-backed wallet provisioning service
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Optional: point at a non-production Privy API
PRIVY_API_BASE_URL=https://api.privy.io/v1

# Required for the current server-side export flow.
# Use the actual P-256 public key material, not a Privy key ID.
# For `.env`, prefer the single-line base64-DER form over multiline PEM.
PRIVY_AUTHORIZATION_KEY_PUBLIC_KEY=your_authorization_key_public_key

# Required in production to sign export requests for owned wallets.
# In Vercel, set this to the PKCS#8 PEM private key and escape newlines as `\n`.
# Locally, if this is unset, the API falls back to `.privy/authorization-private.pem`.
PRIVY_AUTHORIZATION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
